# Example writer routing for the omapi overlay.
# No API keys, tokens, or card material belong in this file.
# Harness auth stays on the host. TYPESAFE_API_KEY is a runtime export,
# never a flake attr or a committed yaml field.

writers:
  default: cursor
  kimi: cursor
  glm: cursor

jev:
  mode: shadow
  # Leave mode at shadow in this file.
  # bypass: set JEV_BYPASS=1 in the process environment, not here.
